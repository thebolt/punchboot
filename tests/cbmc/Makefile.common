#
# Shared rules for the CBMC proofs. A proof directory has a Makefile like
#
#   PROOF   = crc
#   SOURCES = $(ROOT)/src/lib/crc.c
#   UNWIND  = 10
#   include ../../Makefile.common
#
# Variables:
#   PROOF      Name of the proof (output file names)
#   SOURCES    Firmware sources under proof (harness.c is added automatically)
#   UNWIND     Global --unwind bound (plus --unwinding-assertions)
#   EXTRA_INC  Extra include flags
#   PRE_INC    Include flags searched first, e.g. for a config.h wrapper that
#              overrides a Kconfig value (#include_next <config.h>, then #undef)
#   EXTRA_DEFS Extra defines
#   CBMC_EXTRA Extra flags for cbmc (e.g. --unwindset, --object-bits)
#   CHECK_FLAGS_OFF Default checks to turn off, e.g. --unsigned-overflow-check
#              for code that wraps on purpose. Say why in the proof Makefile.
#   ABSTRACT   Functions whose body is replaced by one that returns any value
#              (goto-instrument), for code too big to inline that has its own
#              proof. Say which proof in the proof Makefile, and why the
#              abstraction is enough.
#   UNDEFINED  goto-instrument body option for every function without a body,
#              e.g. assert-false: calling any of them fails the proof
#   MODELS     Models linked into the proof (default: stubs/string_models.c, log.c).
#              The libc proofs set it empty to verify src/lib/libc itself.
#   HOST=1     Host tool code (tools/punchboot): adds the host functions it uses
#              (tests/cbmc/host), the host's signed char and a malloc that can
#              return NULL
#   TIMEOUT    Seconds per cbmc run (default 600). A slow proof sets a longer
#              one with ?=, so the environment still overrides it.
#
# Environment / command line:
#   WORD=32|64  ILP32 (aarch32, i.MX6UL/RT) or LP64 (aarch64, i.MX8) (default 32)
#   BUILD=dir   Output directory, also holds the generated config.h
#
# Everything is compiled against the firmware libc headers (include/libc), not
# the host libc, so type widths are those of the real targets.

ROOT      := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
WORD      ?= 32
BUILD     ?= $(ROOT)/build-cbmc
CBMC      ?= cbmc
GOTO_CC   ?= goto-cc
GOTO_INSTRUMENT ?= goto-instrument
TIMEOUT   ?= 600

ifeq ($(WORD),32)
LIBC_ARCH := aarch32
else ifeq ($(WORD),64)
LIBC_ARCH := aarch64
else
$(error WORD must be 32 or 64)
endif

MODELS    ?= $(ROOT)/tests/cbmc/stubs/string_models.c $(ROOT)/tests/cbmc/stubs/log.c

# Shared harness headers and stubs: a change rebuilds every proof
HDRS      := $(wildcard $(ROOT)/tests/cbmc/*.h $(ROOT)/tests/cbmc/stubs/*.c \
                        $(ROOT)/tests/cbmc/host/*.h)

OUT       := $(BUILD)/$(PROOF)-$(WORD)
CONFIG_H  := $(BUILD)/config.h

INC := -nostdinc \
       $(PRE_INC) \
       $(if $(HOST),-I $(ROOT)/tests/cbmc/host -I $(ROOT)/tools/punchboot) \
       -I $(ROOT)/tests/cbmc \
       -I $(ROOT)/include/libc \
       -I $(ROOT)/include/libc/$(LIBC_ARCH) \
       -I $(ROOT)/include \
       -I $(ROOT)/src \
       -I $(BUILD) \
       $(EXTRA_INC)

# ARM has an unsigned char (aarch32 and aarch64); goto-cc follows the x86 host,
# which is also what the host tools mostly run on
DEFS := $(if $(HOST),-DPB_CBMC_HOST=1,-funsigned-char) -DPB_CBMC=1 -DPB_CBMC_WORD=$(WORD) \
        -DLOGLEVEL=0 $(EXTRA_DEFS)

DEFAULT_CHECKS := --bounds-check \
                  --pointer-check \
                  --pointer-primitive-check \
                  --signed-overflow-check \
                  --unsigned-overflow-check \
                  --conversion-check \
                  --undefined-shift-check \
                  --pointer-overflow-check \
                  --div-by-zero-check

CHECK_FLAGS := $(filter-out $(CHECK_FLAGS_OFF),$(DEFAULT_CHECKS))

# By default CBMC turns a self loop (while (1) {}) into assume(false), which
# silently drops every path that hangs. Keep it a loop, so the unwinding
# assertion reports the hang.
# --slice-formula drops the assignments no property depends on: it halves the
# solver time of the larger proofs. Other solvers (CaDiCaL, Kissat, Z3, cvc5,
# Bitwuzla) were not faster than the default MiniSat (2026-11-03).
CBMC_FLAGS = --function harness $(CHECK_FLAGS) --unwind $(UNWIND) \
             --unwinding-assertions --no-self-loops-to-assumptions --slice-formula \
             $(if $(HOST),--malloc-may-fail --malloc-fail-null) $(CBMC_EXTRA)

.PHONY: all check cover clean

all: check cover

$(CONFIG_H):
	mkdir -p $(BUILD)
	cd $(ROOT) && KCONFIG_CONFIG=configs/host_defconfig python3 scripts/genconfig.py \
	    --header-path $(CONFIG_H) --config-out $(BUILD)/.config src/Kconfig

# The harness itself must compile without warnings: an implicit declaration
# makes CBMC assume an int return, which silently truncates results.
# Replace the bodies of $(ABSTRACT) in $(1) by ones that return any value,
# and give the functions without a body the $(UNDEFINED) body
define abstract
	$(if $(UNDEFINED),$(GOTO_INSTRUMENT) --generate-function-body '^(?!__CPROVER_).*' \
	    --generate-function-body-options $(UNDEFINED) $(1) $(1).tmp && mv $(1).tmp $(1))
	$(if $(ABSTRACT),$(GOTO_INSTRUMENT) $(foreach f,$(ABSTRACT),--remove-function-body $(f)) \
	    $(1) $(1).tmp && $(GOTO_INSTRUMENT) \
	    --generate-function-body '$(subst $(space),|,$(strip $(ABSTRACT)))' \
	    --generate-function-body-options nondet-return $(1).tmp $(1) && rm $(1).tmp)
endef

space := $(subst ,, )

$(OUT).gb: harness.c $(SOURCES) $(MODELS) $(HDRS) $(CONFIG_H)
	mkdir -p $(BUILD)
	$(GOTO_CC) -m$(WORD) -std=gnu99 $(INC) $(DEFS) -Werror -c harness.c -o $(OUT).harness.o
	$(GOTO_CC) -m$(WORD) -std=gnu99 $(INC) $(DEFS) harness.c $(SOURCES) $(MODELS) -o $@
	$(call abstract,$@)

$(OUT).cover.gb: harness.c $(SOURCES) $(MODELS) $(HDRS) $(CONFIG_H)
	mkdir -p $(BUILD)
	$(GOTO_CC) -m$(WORD) -std=gnu99 $(INC) $(DEFS) -DPB_CBMC_COVER=1 harness.c $(SOURCES) $(MODELS) -o $@
	$(call abstract,$@)

# Property checks. Fails if a property fails that is not listed in
# expected_failures.txt (known bugs, with their finding id), if a listed one no
# longer fails, or if an unwinding bound is too low.
check: $(OUT).gb
	timeout $(TIMEOUT) $(CBMC) $< $(CBMC_FLAGS) > $(OUT).log 2>&1 || true
	@tail -n 3 $(OUT).log
	@python3 $(ROOT)/tests/cbmc/check_result.py $(OUT).log $(WORD) expected_failures.txt

# Vacuity guard: every PB_COVER() goal in the harness must be reachable.
cover: $(OUT).cover.gb
	timeout $(TIMEOUT) $(CBMC) $< --function harness --unwind $(UNWIND) \
	    --cover cover $(if $(HOST),--malloc-may-fail --malloc-fail-null) $(CBMC_EXTRA) 2>&1 | \
	    tee $(OUT).cover.log | tail -n 3
	@grep -q "covered" $(OUT).cover.log || { echo "no PB_COVER goals in the harness"; exit 1; }
	@grep -q "covered (100.0%)" $(OUT).cover.log || \
	    { grep "coverage.*FAILED" $(OUT).cover.log; echo "unreachable cover goals"; exit 1; }

clean:
	rm -f $(OUT).gb $(OUT).harness.o $(OUT).cover.gb $(OUT).log $(OUT).cover.log
